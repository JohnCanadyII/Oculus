# Normalize line endings: store text as LF in the repo, check out native on each OS.
# Stops the "LF will be replaced by CRLF" warnings on Windows.
* text=auto eol=lf

# Binary assets — never touch line endings.
*.png binary
*.db binary

# Windows helper scripts keep CRLF.
*.ps1 text eol=crlf
*.bat text eol=crlf
